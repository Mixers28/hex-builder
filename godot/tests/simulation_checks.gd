extends SceneTree

const Sim = preload("res://core/simulation.gd")
const Rules = preload("res://core/rules.gd")
const Store = preload("res://core/save_store.gd")
const Scenario = preload("res://tests/frontier_scenario.gd")
const Legacy = preload("res://tests/legacy_fixture.gd")
var failures = 0
var passed = 0

func _initialize() -> void:
	call_deferred("run")

func check(condition: bool, message: String) -> void:
	if condition:
		passed += 1
		print("PASS: ",message)
	else:
		failures += 1
		push_error("FAIL: "+message)

func fresh():
	var s = Sim.new()
	s.start()
	return s

func run() -> void:
	var s = fresh()
	check(s.tiles.size()==37 and s.state.population==4,"small revealed start and four pioneers")
	check(Sim.validate(s.record())=="","new state validates")
	var original = JSON.stringify(s.record())
	check(not s.try_claim("0,5").ok and JSON.stringify(s.record())==original,"fog prevents claims without partial spending")
	check(not s.try_build("0,1","quarry").ok,"research and deposit gates reject quarry")
	check(s.try_build("0,1","house").ok and s.tiles["0,1"].residents==0,"housing creates capacity, not instant residents")
	check(s.try_build("-1,1","forager").ok and s.try_workers("-1,1",1).ok,"assign a production worker")
	s.step(89)
	check(s.state.population==4 and s.tiles["0,1"].residents==0,"immigration waits for its actual interval")
	s.step(1)
	check(s.state.population==5 and s.tiles["0,1"].residents==1,"one newcomer automatically occupies housing")
	check(s.assigned()==1 and s.free_workers()==4,"newcomer does not silently change crew assignments")
	check(s.try_build("-1,0","logging").ok and s.try_workers("-1,0",3).ok,"multi-worker production crew")
	check(not s.try_workers("-1,1",3).ok,"crew capacity is enforced")
	check(s.try_build("1,0","mine").ok and not s.try_workers("1,0",2).ok,"global population limit is enforced")
	var fast = fresh()
	fast.try_build("-1,0","logging")
	fast.try_workers("-1,0",3)
	var slow = fresh()
	slow.try_build("-1,0","logging")
	slow.try_workers("-1,0",1)
	fast.step(6)
	slow.step(6)
	check(fast.state.shipments.size()==1 and slow.state.shipments.is_empty(),"extra crew speeds actual work")
	var timber = fast.state.stock.timber
	fast.step(0.5)
	check(fast.state.stock.timber==timber and fast.tiles["-1,0"].work==0,"goods in transit are not credited and producer waits")
	fast.try_workers("-1,0",0)
	fast.step(1)
	check(fast.state.stock.timber==timber+3,"dispatched cargo arrives once after crew release")
	fast.step(3)
	check(fast.state.stock.timber==timber+3,"delivery cannot award twice")
	var saved = s.record()
	var restored = Sim.new()
	var restore_error = restored.restore(JSON.parse_string(JSON.stringify(saved)))
	check(restore_error=="","JSON save restores authoritative state: "+restore_error)
	if restore_error!="":
		quit(1)
		return
	s.step(12.375)
	restored.step(12.375)
	check(JSON.stringify(s.record())==JSON.stringify(restored.record()),"save continuity includes clocks, crews, jobs, migrants and cargo")
	var invalid = saved.duplicate(true)
	invalid.tiles.append(invalid.tiles[0].duplicate(true))
	var before = JSON.stringify(restored.record())
	check(restored.restore(invalid)!="" and JSON.stringify(restored.record())==before,"invalid load rejects without replacing live settlement")
	invalid = saved.duplicate(true)
	invalid.stock.food = -1
	check(Sim.validate(invalid)!="","negative resources rejected")
	invalid = saved.duplicate(true)
	invalid.remainder = 5
	check(Sim.validate(invalid)!="","invalid simulation remainder rejected")
	var seeded = Sim.new()
	seeded.start(418)
	check(seeded.generate(Vector2i(7,1))!=s.generate(Vector2i(7,1)),"frontier varies across seeds")
	var revealed = s.tiles.size()
	s.reveal(Vector2i(0,3),4)
	var deposit = s.tiles["0,5"].duplicate(true)
	s.reveal(Vector2i(0,3),4)
	check(s.tiles.size()>revealed and s.tiles["0,5"]==deposit,"revealing seeded frontier never regenerates a deposit")
	var starvation = fresh()
	starvation.try_build("0,1","house")
	starvation.state.stock.food = 0
	starvation.step(120)
	check(starvation.state.population==4 and starvation.state.hungry,"shortage pauses migration without killing citizens")
	check(starvation.try_forage("0,0").ok and not starvation.try_forage("0,0").ok,"manual food recovery has a global cooldown")
	check(starvation.try_gather("-1,0").ok and starvation.try_gather("1,0").ok,"manual timber and ore recovery remain available")
	var scenario = Scenario.new().run()
	check(scenario.ok,"Complete discovery, research, quarry delivery and second expansion with earned resources: "+str(scenario.get("error","complete")))
	if scenario.ok:
		print("Frontier: %.1f simulated minutes, %d validated commands" % [scenario.seconds/60.0,scenario.commands])
		check(scenario.snapshots.extraction.stock.stone==0 and scenario.snapshots.extraction.shipments.any(func(c): return c.resource=="stone"),"first quarry output is cargo before it becomes spendable stone")
		check(scenario.simulation.state.expansions==1 and scenario.simulation.tiles.size()>scenario.snapshots.discovery.tiles.size(),"stone investment opens a second discovery area")
		var clone = Sim.new()
		clone.restore(scenario.snapshots.expansion)
		var deposit_count = clone.tiles["0,5"].stone
		var known_count = clone.tiles.size()
		for id in clone.tiles:
			if clone.tiles[id].workers>0: clone.try_workers(id,0)
		clone.step(20)
		check(clone.try_remove("0,2").ok and clone.tiles.size()==known_count and clone.tiles["0,5"].stone==deposit_count,"removing a tower preserves knowledge and finite deposits")
	check_accounting()
	check_saves()
	check_frontier(scenario)
	print("Simulation checks: %d passed, %d failed" % [passed,failures])
	quit(0 if failures==0 else 1)

func check_accounting() -> void:
	var s = fresh()
	s.try_build("0,1","smelter")
	s.try_build("0,-1","smelter")
	s.try_workers("0,1",1)
	s.try_workers("0,-1",1)
	s.try_gather("1,0")
	s.try_gather("1,0")
	s.step(1)
	check(s.state.stock.ore==0 and s.tiles["0,1"].reserved+s.tiles["0,-1"].reserved==2,"two foundries cannot reserve the same ore")
	var source = "0,1" if s.tiles["0,1"].reserved==2 else "0,-1"
	var work = s.tiles[source].work
	s.try_workers(source,0)
	s.step(5)
	check(s.tiles[source].work==work and s.tiles[source].reserved==2,"crew release preserves paid inputs and partial work")
	var clone = Sim.new()
	check(clone.restore(JSON.parse_string(JSON.stringify(s.record())))=="" and clone.tiles[source].reserved==2,"reserved input survives JSON round-trip without refund")
	check(s.try_remove(source).ok and s.state.stock.ore==2,"demolishing a foundry refunds its unprocessed reservation once")
	check(not s.try_remove("0,0").ok,"permanent village hall cannot be removed")
	s = fresh()
	s.try_build("0,1","house")
	s.try_build("-1,1","forager")
	s.try_workers("-1,1",1)
	s.step(90)
	check(not s.try_remove("0,1").ok,"occupied homes cannot be removed")
	s = fresh()
	s.try_build("1,0","mine")
	s.try_workers("1,0",1)
	var total_ore = s.tiles["1,0"].initial_ore
	s.step(800)
	check(s.state.stock.ore==total_ore and s.tiles["1,0"].building=="" and s.tiles["1,0"].road and s.assigned()==0,"finite mine delivers exactly its deposit then releases crew and keeps the road")
	s = fresh()
	s.try_build("-1,0","logging")
	s.try_workers("-1,0",1)
	s.step(12)
	check(not s.try_remove("-1,0").ok,"active cargo protects its source and road")
	var invalid = s.record()
	invalid.shipments[0].amount = 40
	check(Sim.validate(invalid)!="","oversized cargo rejected")
	invalid = s.record()
	invalid.shipments[0].path = ["-1,0","2,0","0,0"]
	check(Sim.validate(invalid)!="","broken delivery route rejected")
	invalid = s.record()
	invalid.shipments.append(invalid.shipments[0].duplicate(true))
	check(Sim.validate(invalid)!="","duplicate cargo cannot mint resources")
	s = fresh()
	s.state.stock.timber = Rules.STOCK_LIMIT
	s.try_build("-1,0","logging")
	s.try_workers("-1,0",1)
	s.state.stock.timber = Rules.STOCK_LIMIT
	var before = JSON.stringify(s.record())
	check(not s.try_gather("-1,0").ok and JSON.stringify(s.record())==before,"manual gathering does not overflow stock")
	s.step(20)
	check(s.state.shipments.is_empty() and s.tiles["-1,0"].work==0 and Sim.validate(s.record())=="","full stores block production without losing deposits")
	# A longer route includes delivery time, even with identical crew and work.
	var near = fresh()
	near.try_build("0,1","forager")
	near.try_workers("0,1",1)
	var far = fresh()
	far.try_road("0,1")
	far.try_claim("0,2")
	far.try_road("0,2")
	far.try_claim("0,3")
	far.try_build("0,3","forager")
	far.try_workers("0,3",1)
	near.step(120)
	far.step(120)
	check(near.state.stock.food>far.state.stock.food,"road distance still reduces actual production throughput")
	var disconnected = fresh()
	disconnected.try_claim("0,2")
	disconnected.try_build("0,2","forager")
	disconnected.try_workers("0,2",1)
	disconnected.step(30)
	check(disconnected.tiles["0,2"].work==0 and disconnected.state.shipments.is_empty(),"disconnected production cannot create goods")
	# Focused production fixtures start with capabilities unlocked; the frontier
	# scenario above separately earns its research through normal commands.
	s = fresh()
	s.state.research = ["reforestation"]
	s.try_build("0,-1","forester")
	s.try_workers("0,-1",1)
	s.try_build("-1,0","logging")
	s.try_workers("-1,0",1)
	while s.tiles["-1,0"].trees>0: s.try_gather("-1,0")
	check(s.tiles["-1,0"].building=="logging","managed logging remains after its trees are exhausted")
	var timber_before = s.state.stock.timber
	s.step(16)
	check(s.tiles["-1,0"].sapling>=0,"nursery prioritizes a depleted logging plot among equal candidates")
	clone = Sim.new()
	check(clone.restore(JSON.parse_string(JSON.stringify(s.record())))=="","planted sapling and forestry work survive saving")
	s.step(114)
	clone.step(114)
	check(s.state.stock.timber>timber_before and JSON.stringify(s.record())==JSON.stringify(clone.record()),"renewable woodland matures, is harvested and delivers without reload divergence")
	s = fresh()
	s.state.research = ["deep_mining"]
	check(not s.try_build("1,0","deep_mine").ok,"deep mining requires surface depletion")
	var reserve = s.tiles["1,0"].initial_deep+s.tiles["1,0"].initial_ore
	while s.tiles["1,0"].ore>0: s.try_gather("1,0")
	s.try_build("1,0","deep_mine")
	s.try_workers("1,0",1)
	s.step(2200)
	check(s.state.stock.ore==reserve and s.tiles["1,0"].deep==0 and s.tiles["1,0"].building=="" and Sim.validate(s.record())=="","deep reserves are finite and delivered exactly once")
	s = fresh()
	s.state.research = ["farming"]
	s.try_build("0,1","farm")
	s.try_workers("0,1",2)
	s.step(18)
	check(s.state.stock.food==30,"staffed farm delivers its larger food batch")

func check_saves() -> void:
	for version in [1,2]:
		var original = Legacy.make(version)
		var original_text = JSON.stringify(original)
		var result = Store.import_unity(JSON.parse_string(original_text))
		check(result.ok,"Unity schema %d imports: %s" % [version,result.get("error","")])
		if not result.ok: continue
		var migrated = Sim.new()
		check(migrated.restore(result.record)=="","imported state restores")
		check(migrated.tiles.size()==127 and migrated.state.stock.timber==37 and migrated.state.stock.ore==9 and migrated.tiles["1,-1"].reserved==2,"legacy known territory, stores and reserved input preserved")
		check(migrated.tiles["1,0"].deep==80 and migrated.tiles["1,-1"].work==9.0,"legacy deep deposits and completion fraction preserved")
		check(migrated.state.shipments[0].elapsed==0.25 and migrated.state.shipments[0].duration==0.75,"legacy cargo retains its remaining journey")
		check(migrated.state.population==(4 if version==1 else 6) and migrated.state.stock.food==(24 if version==1 else 29),"legacy town migration grants only the schema-one starting town")
		var roundtrip = Sim.new()
		check(roundtrip.restore(JSON.parse_string(JSON.stringify(migrated.record())))=="","converted save uses the native schema")
		migrated.step(0.5)
		roundtrip.step(0.5)
		check(migrated.state.stock.timber==40 and JSON.stringify(migrated.record())==JSON.stringify(roundtrip.record()),"legacy cargo arrives once and reload advances identically")
		check(JSON.stringify(original)==original_text,"import never mutates its source payload")
	var credit = Legacy.make()
	credit.Town.Research = 0
	var result = Store.import_unity(credit)
	var s = Sim.new()
	if result.ok: s.restore(result.record)
	check(result.ok and s.state.legacy_research_points==1 and s.try_research("farming").ok and s.state.legacy_research_points==0,"unspent legacy research credit remains usable exactly once")
	var malformed = Legacy.make()
	malformed.Tiles[0].SaplingAge = "broken"
	check(not Store.import_unity(malformed).ok,"malformed legacy timers fail safely")
	malformed = Legacy.make()
	malformed.Tiles.append(malformed.Tiles[0])
	check(not Store.import_unity(malformed).ok,"duplicate legacy map rejected")
	var output_dir = OS.get_environment("ALPHA_HEX_QA_OUTPUT") if OS.has_environment("ALPHA_HEX_QA_OUTPUT") else ProjectSettings.globalize_path("res://qa-output")
	DirAccess.make_dir_recursive_absolute(output_dir)
	var marker = FileAccess.open(output_dir.path_join(".gdignore"),FileAccess.WRITE)
	if marker: marker.close()
	var path = output_dir.path_join("save-check-%d.json" % Time.get_ticks_usec())
	s = fresh()
	check(Store.write(s,path)=="","atomic save writes validated state")
	var original_record = s.record()
	s.try_build("0,1","house")
	check(Store.write(s,path)=="" and Store.read(path).ok,"replacement save creates a readable primary")
	var backup = Store.read(path+".bak")
	check(backup.ok and JSON.stringify(backup.simulation.record())==JSON.stringify(original_record),"backup retains previous valid save")
	var file = FileAccess.open(path,FileAccess.WRITE)
	file.store_string("{broken"); file.close()
	var recovered = Store.load_with_backup(path)
	check(recovered.ok and recovered.get("recovered",false),"corrupt primary falls back to validated backup")
	check(Store.write(s,path)=="" and JSON.stringify(Store.read(path+".bak").simulation.record())==JSON.stringify(original_record),"saving after corruption preserves the good backup")
	var invalid = fresh()
	invalid.state.stock.food = -1
	var text_before = FileAccess.get_file_as_string(path)
	check(Store.write(invalid,path)!="" and FileAccess.get_file_as_string(path)==text_before,"invalid replacement cannot damage an existing save")
	for suffix in ["",".bak",".pending"]:
		if FileAccess.file_exists(path+suffix): DirAccess.remove_absolute(path+suffix)
	for arg in OS.get_cmdline_user_args():
		if not arg.begins_with("--legacy="): continue
		var source = arg.trim_prefix("--legacy=")
		var fingerprint = FileAccess.get_sha256(source)
		var loaded = Store.read(source)
		check(loaded.ok,"Existing Unity artifact imports: "+source.get_file()+" "+loaded.get("error",""))
		if loaded.ok:
			loaded.simulation.step(30)
			check(Sim.validate(loaded.simulation.record())=="","existing migrated town advances and remains valid")
		check(fingerprint==FileAccess.get_sha256(source),"existing Unity artifact is unchanged")

func check_frontier(scenario: Dictionary) -> void:
	var alternate = Scenario.new().run(418)
	check(alternate.ok,"second seed supports the same complete resource frontier: "+alternate.get("error","complete"))
	if not scenario.ok: return
	var s = Sim.new()
	s.restore(scenario.snapshots.expansion)
	var valid = s.record()
	var invalid = valid.duplicate(true)
	for t in invalid.tiles:
		if t.building=="watchtower": t.tower_level=0
	check(Sim.validate(invalid)!="","a tower needs a valid research-backed upgrade level")
	var known = s.tiles.size()
	var deposit = s.tiles["0,5"].stone
	var stock = s.state.stock.duplicate()
	check(not s.try_upgrade("0,2").ok and s.tiles.size()==known and s.tiles["0,5"].stone==deposit and s.state.stock==stock,"repeating tower reinforcement cannot spend twice or refill deposits")
	s.reveal(Vector2i.ZERO,Rules.WORLD_LIMIT+3)
	check(s.tiles.size()==817 and Sim.validate(s.record())=="","tested world boundary contains exactly 817 hex coordinates")
	var copy = Sim.new()
	check(copy.restore(JSON.parse_string(JSON.stringify(s.record())))=="" and copy.tiles.size()==817,"full supported map round-trips through JSON")
	s = fresh()
	s.state.research = ["surveying"]
	s.try_claim("0,2")
	check(s.try_build("0,2","watchtower").ok and s.tiles.size()==37,"disconnected tower does not survey")
	var supplies = s.state.stock.duplicate()
	s.try_road("0,1")
	check(s.tiles.size()>37 and not s.tiles["0,5"].claimed and s.state.stock.metal==supplies.metal and s.state.stock.timber==supplies.timber-2,"road connection reveals frontier without claiming land or granting stock")
