{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Simulation: run checks",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "tools/SimulationChecks/SimulationChecks.csproj", "--configuration", "Release"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Repository: validate structure",
      "type": "process",
      "command": "python3",
      "windows": {"command": "python"},
      "args": ["tools/validate_repo.py"],
      "problemMatcher": []
    },
    {
      "label": "Unity: open project",
      "type": "process",
      "command": "python3",
      "windows": {"command": "python"},
      "args": ["tools/unity_cli.py", "open"],
      "problemMatcher": []
    },
    {
      "label": "Unity: run EditMode tests",
      "type": "process",
      "command": "python3",
      "windows": {"command": "python"},
      "args": ["tools/unity_cli.py", "test"],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
