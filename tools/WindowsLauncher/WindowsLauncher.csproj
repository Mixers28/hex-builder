<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlphaHex</AssemblyName>
    <RootNamespace>AlphaHex.Updates</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/AlphaHex/Scripts/Runtime/UpdateProtocol.cs" Link="UpdateProtocol.cs" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
